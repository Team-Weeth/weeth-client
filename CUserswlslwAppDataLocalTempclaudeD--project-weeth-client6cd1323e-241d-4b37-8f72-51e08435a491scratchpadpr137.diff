+    >
+      <AlertDialogAction onClick={handleConfirm}>탈퇴하기</AlertDialogAction>
+      <AlertDialogCancel>취소</AlertDialogCancel>
+    </AlertDialog>
+  );
+}
+
+export { WithdrawConfirmDialog, type WithdrawConfirmDialogProps };
