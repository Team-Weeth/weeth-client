+        <StepTwoContent
+          selectedClubIds={selectedClubIds}
+          onToggleClub={handleToggleClub}
+          onPrev={() => setStep(1)}
+          onConfirm={handleConfirm}
+          mobileFixedFooter
+        />
+      )}
+    </div>
+  );
+}
+
+export { AddProfilePageContent, type AddProfilePageContentProps };
