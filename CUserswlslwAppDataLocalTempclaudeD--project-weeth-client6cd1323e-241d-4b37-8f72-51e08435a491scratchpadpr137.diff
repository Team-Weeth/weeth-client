+      >
+        <Button variant="secondary" size="lg" className="flex-1" onClick={onPrev}>
+          이전
+        </Button>
+        <Button variant="primary" size="lg" className="flex-1" onClick={onConfirm}>
+          확인
+        </Button>
+      </div>
+    </div>
+  );
+}
+
+export { StepTwoContent, type StepTwoContentProps };
