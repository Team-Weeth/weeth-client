+          />
+        ))}
+      </div>
+
+      {step === 1 ? (
+        <StepOneContent
+          control={control}
+          errors={errors}
+          onCancel={handleClose}
+          onNext={handleNext}
+          cancelAsDialogClose={false}
+          mobileFixedFooter
+        />
