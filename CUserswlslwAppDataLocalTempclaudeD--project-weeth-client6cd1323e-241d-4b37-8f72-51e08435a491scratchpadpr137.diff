+  open: boolean;
+  onOpenChange: (open: boolean) => void;
+  onConfirm?: () => void;
+}
+
+function WithdrawConfirmDialog({ open, onOpenChange, onConfirm }: WithdrawConfirmDialogProps) {
+  const handleConfirm = () => {
+    onConfirm?.();
+    onOpenChange(false);
+  };
+
+  return (
+    <AlertDialog
+      open={open}
+      onOpenChange={onOpenChange}
+      status="danger"
+      title={'서비스를 탈퇴하면\n모든 활동 기록이 사라져요'}
