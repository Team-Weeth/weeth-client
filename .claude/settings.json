{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    },
    "weeth-api": {
      "command": "npx",
      "args": ["-y", "@ivotoby/openapi-mcp-server"],
      "env": {
        "API_BASE_URL": "https://api-dev.v4.weeth.kr",
        "OPENAPI_SPEC_PATH": "https://api-dev.v4.weeth.kr/swagger-ui/index.html#/"
      }
    }
  },
  "permissions": {
    "allow": [
      "Bash(pnpm *)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git status*)",
      "Read(**)",
      "Glob(**)",
      "Grep(**)",
      "Edit(**)",
      "Write(**)",
      "Bash(gh api:*)"
    ],
    "ask": [
      "Bash(gh api *-X *)",
      "Bash(gh api *--method *)",
      "Bash(gh api *-f *)",
      "Bash(gh api *-F *)",
      "Bash(gh api *--field *)",
      "Bash(gh api *--raw-field *)",
      "Bash(gh api *--input *)"
    ],
    "deny": [
      "Bash(gh pr merge:*)",
      "Bash(gh api *merge*)",
      "Bash(git push * main)",
      "Bash(git push *:main)",
      "Bash(git push * develop)",
      "Bash(git push *:develop)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/skill-suggest.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc 'set -o pipefail; cd \"$CLAUDE_PROJECT_DIR\" && pnpm lint:fix --quiet 2>&1 | tail -5'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && echo '⚡ TypeScript 검사 중...' && pnpm typecheck 2>&1 && echo '✅ 타입 에러 없음' || echo '❌ 타입 에러 발견 — 위 오류를 확인하세요'"
          }
        ]
      }
    ]
  }
}
