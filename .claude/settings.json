{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    },
    "weeth-api": {
      "command": "npx",
      "args": ["-y", "@ivotoby/openapi-mcp-server"],
      "env": {
        "API_BASE_URL": "https://api-dev.v4.weeth.kr",
        "OPENAPI_SPEC_PATH": "https://api-dev.v4.weeth.kr/swagger-ui/index.html#/"
      }
    }
  },
  "permissions": {
    "allow": [
      "Bash(pnpm *)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git status*)",
      "Read(**)",
      "Glob(**)",
      "Grep(**)",
      "Edit(**)",
      "Write(**)",
      "Bash(gh api:*)"
    ],
    "ask": [
      "Bash(gh api *-X *)",
      "Bash(gh api *--method *)",
      "Bash(gh api *-f *)",
      "Bash(gh api *-F *)",
      "Bash(gh api *--field *)",
      "Bash(gh api *--raw-field *)",
      "Bash(gh api *--input *)"
    ],
    "deny": [
      "Bash(gh pr merge:*)",
      "Bash(gh api *merge*)",
      "Bash(git push * main)",
      "Bash(git push *:main)",
      "Bash(git push * develop)",
      "Bash(git push *:develop)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/skill-suggest.sh\""
          },
          {
            "type": "command",
            "command": "bash -l -c 'command -v node >/dev/null 2>&1 || { echo \"verify: node not found, skipping\" >&2; exit 0; }; cd \"$CLAUDE_PROJECT_DIR\" && node scripts/harness/verify.mjs --snapshot'",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash -l -c 'command -v node >/dev/null 2>&1 || { echo \"verify: node not found, skipping\" >&2; exit 0; }; cd \"$CLAUDE_PROJECT_DIR\" && node scripts/harness/verify.mjs --format-edited'",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -l -c 'command -v node >/dev/null 2>&1 || { echo \"verify: node not found, skipping\" >&2; exit 0; }; cd \"$CLAUDE_PROJECT_DIR\" && node scripts/harness/verify.mjs --stop-hook'",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
